+        function updateBackgroundAudioButton() {
+            const audio = document.getElementById('backgroundAudio');
+            const button = document.getElementById('backgroundAudioToggle');
+            if (!audio || !button) return;
+            const hasSource = Boolean(audio.src);
+            button.style.display = hasSource ? 'block' : 'none';
+            button.innerText = !audio.paused ? '⏸' : '▶';
+            button.title = !audio.paused ? 'إيقاف المقطع الصوتي' : 'تشغيل المقطع الصوتي';
+            button.setAttribute('aria-label', button.title);
+        }
+
+        async function tryStartBackgroundAudio() {
+            const audio = document.getElementById('backgroundAudio');
+            if (!audio || !audio.src || localStorage.getItem('background_audio_enabled') === 'false') return;
+            try {
+                await audio.play();
+            } catch (error) {
+                // تمنع المتصفحات التشغيل التلقائي حتى يحدث تفاعل من المستخدم.
+            }
+            updateBackgroundAudioButton();
+        }
+
+        function bindAudioInteraction() {
+            if (audioInteractionBound) return;
+            audioInteractionBound = true;
+            const start = () => tryStartBackgroundAudio();
+            document.addEventListener('pointerdown', start, { passive: true });
+            document.addEventListener('keydown', start, { passive: true });
+        }
+
+        async function applyBackgroundAudio(settings, cachedRecord = null) {
+            const audio = document.getElementById('backgroundAudio');
+            if (!audio || !settings || !settings.url) return;
+            if (backgroundAudioObjectUrl) URL.revokeObjectURL(backgroundAudioObjectUrl);
+            backgroundAudioObjectUrl = null;
+            if (cachedRecord && cachedRecord.blob) {
+                backgroundAudioObjectUrl = URL.createObjectURL(cachedRecord.blob);
+                audio.src = backgroundAudioObjectUrl;
+            } else {
+                audio.src = settings.url;
+            }
+            audio.loop = true;
+            audio.onplay = updateBackgroundAudioButton;
+            audio.onpause = updateBackgroundAudioButton;
+            updateBackgroundAudioButton();
+            bindAudioInteraction();
+            await tryStartBackgroundAudio();
+        }
+
+        async function loadBackgroundAudio() {
+            try {
+                const response = await fetch(`${DATABASE_URL}/settings/audio.json?cache=${Date.now()}`, { cache: 'no-store' });
+                if (!response.ok) throw new Error(`تعذر جلب إعداد الصوت: ${response.status}`);
+                const settings = await response.json();
+                backgroundAudioSettings = settings && settings.url ? settings : null;
+                if (!backgroundAudioSettings) return;
+                let cachedRecord = await OfflineStore.getAudio('background').catch(() => null);
+                if (!cachedRecord || cachedRecord.url !== backgroundAudioSettings.url) {
+                    const audioResponse = await fetch(backgroundAudioSettings.url, { cache: 'no-store' });
+                    if (audioResponse.ok) {
+                        const blob = await audioResponse.blob();
+                        cachedRecord = { url: backgroundAudioSettings.url, blob, name: backgroundAudioSettings.name || '' };
+                        await OfflineStore.putAudio('background', cachedRecord);
+                    }
+                }
+                await applyBackgroundAudio(backgroundAudioSettings, cachedRecord);
+            } catch (error) {
+                console.warn('تعذر تحميل المقطع الصوتي العام:', error);
+                const cachedRecord = await OfflineStore.getAudio('background').catch(() => null);
+                if (cachedRecord?.blob) await applyBackgroundAudio({ url: cachedRecord.url }, cachedRecord);
+            }
+        }
+
+        window.toggleBackgroundAudio = async () => {
+            const audio = document.getElementById('backgroundAudio');
+            if (!audio || !audio.src) return;
+            if (audio.paused) {
+                localStorage.setItem('background_audio_enabled', 'true');
+                await tryStartBackgroundAudio();
+            } else {
+                localStorage.setItem('background_audio_enabled', 'false');
+                audio.pause();
+                updateBackgroundAudioButton();
+            }
+        };
+
+        window.uploadBackgroundAudio = async () => {
+            const input = document.getElementById('backgroundAudioInput');
+            const status = document.getElementById('backgroundAudioStatus');
+            const file = input?.files?.[0];
+            if (!file) { if (status) status.innerText = 'اختر ملفًا صوتيًا أولًا.'; return; }
+            if (!file.type.startsWith('audio/')) { if (status) status.innerText = 'الملف المختار ليس ملفًا صوتيًا.'; return; }
+            try {
+                if (status) status.innerText = 'جارٍ رفع المقطع الصوتي...';
+                const storageRef = firebase.storage().ref(`site-audio/background-${Date.now()}-${file.name}`);
+                const snapshot = await storageRef.put(file, { contentType: file.type });
+                const url = await snapshot.ref.getDownloadURL();
+                const settings = { url, name: file.name, type: file.type, size: file.size, updatedAt: Date.now(), enabled: true };
+                await db.ref('settings/audio').set(settings);
+                await OfflineStore.putAudio('background', { url, name: file.name, blob: file });
+                backgroundAudioSettings = settings;
+                await applyBackgroundAudio(settings, { url, name: file.name, blob: file });
+                if (input) input.value = '';
+                if (status) status.innerText = 'تم رفع وتفعيل المقطع الصوتي لجميع المستخدمين.';
+            } catch (error) {
+                console.error('فشل رفع المقطع الصوتي:', error);
+                if (status) status.innerText = 'تعذر رفع المقطع: ' + (error.code || error.message || 'تحقق من صلاحيات Firebase Storage.');
+            }
+        };
+
+        window.removeBackgroundAudio = async () => {
+            const status = document.getElementById('backgroundAudioStatus');
+            if (!confirm('هل تريد إيقاف وحذف المقطع الصوتي العام؟')) return;
+            try {
+                await db.ref('settings/audio').remove();
+                await OfflineStore.deleteAudio('background');
+                const audio = document.getElementById('backgroundAudio');
+                if (audio) { audio.pause(); audio.removeAttribute('src'); audio.load(); }
+                backgroundAudioSettings = null;
+                updateBackgroundAudioButton();
+                if (status) status.innerText = 'تم إيقاف وحذف المقطع الصوتي العام.';
+            } catch (error) {
+                if (status) status.innerText = 'تعذر حذف المقطع: ' + (error.code || error.message || 'تحقق من الصلاحيات.');
+            }
+        };
+
         function toArabicNum(n) {
