async function loadCachedData() {
    try {
        if (typeof OfflineStore !== 'undefined' && OfflineStore.getAllKhatmas) {
            const cachedData = await OfflineStore.getAllKhatmas();
            if (cachedData && Object.keys(cachedData).length > 0) {
                allKhatmas = cachedData;
                stopLoadingProgress();
                renderCurrentData();
                return true;
            }
        }

        const legacyData = JSON.parse(localStorage.getItem('offline_khatmas_perfect') || 'null');
        if (legacyData && Object.keys(legacyData).length > 0) {
            allKhatmas = legacyData;
            if (typeof OfflineStore !== 'undefined' && OfflineStore.replaceAllKhatmas) {
                await OfflineStore.replaceAllKhatmas(legacyData);
            }
            localStorage.removeItem('offline_khatmas_perfect');
            stopLoadingProgress();
            renderCurrentData();
            return true;
        }
    } catch (error) {
        console.error('تعذر قراءة البيانات المحلية:', error);
    }
    return false;
}

async function syncDataFromNetwork() {
    if (syncInProgress || !navigator.onLine) {
        stopLoadingProgress(); // ضمان إيقاف التحميل إذا لم يكن هناك إنترنت
        return;
    }
    syncInProgress = true;
    lastSyncAttempt = Date.now();

    try {
        const response = await fetch(`${DATABASE_URL}/khatmas.json`, {
            method: 'GET',
            cache: 'no-store'
        });

        if (!response.ok) {
            throw new Error(`تعذر جلب التحديثات: ${response.status}`);
        }

        const data = (await response.json()) || {};
        
        if (Object.keys(data).length > 0) {
            if (typeof OfflineStore !== 'undefined' && OfflineStore.replaceAllKhatmas) {
                await OfflineStore.replaceAllKhatmas(data);
            }
            allKhatmas = data;
        } else {
            if (typeof OfflineStore !== 'undefined' && OfflineStore.getAllKhatmas) {
                const cached = await OfflineStore.getAllKhatmas();
                if (cached && Object.keys(cached).length > 0) {
                    allKhatmas = cached;
                }
            }
        }

        stopLoadingProgress();
        renderCurrentData();
    } catch (error) {
        console.warn('استخدام النسخة المحلية المؤقتة:', error);
        if (typeof OfflineStore !== 'undefined' && OfflineStore.getAllKhatmas) {
            const cached = await OfflineStore.getAllKhatmas();
            if (cached && Object.keys(cached).length > 0) {
                allKhatmas = cached;
            }
        }
        stopLoadingProgress();
        renderCurrentData();
    } finally {
        syncInProgress = false;
        stopLoadingProgress(); // تأكيد أخير لإخفاء شاشة التحميل نهائياً
    }
}

async function initializeOfflineFirstApp() {
    startLoadingProgress();
    
    // محاولة جلب الكاش المحلي أولاً
    const hasCached = await loadCachedData();
    
    // إذا كان متصلاً، جلب البيانات من الشبكة، وإلا فقف هنا وأزل شاشة التحميل
    if (navigator.onLine) {
        await syncDataFromNetwork();
    } else {
        stopLoadingProgress();
        if (!hasCached) {
            renderCurrentData();
        }
    }
}
