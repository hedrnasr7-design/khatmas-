From fc7482102a8663bbd0f51b2ae97c8b1663dbedbb Mon Sep 17 00:00:00 2001
From: Manus <manus@users.noreply.github.com>
Date: Tue, 8 Sep 2026 15:15:50 +0000
Subject: [PATCH] Keep quotes marquee continuously visible

---
 index.html | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/index.html b/index.html
index 187c8d2..481fc82 100644
--- a/index.html
+++ b/index.html
@@ -107,8 +107,8 @@
         .search-box { flex: 1; padding: 7px 9px; height:44px; border-radius: 8px; border: 2px solid #1b4332; font-size: 15px; box-sizing: border-box; text-align: right; background: #fff; }
 
         .quotes-box { width:var(--content-width); height:42px; margin:0 auto 8px; border:2px solid var(--quotes-border, #1b4332); border-radius:9px; overflow:hidden; display:flex; align-items:center; background:var(--quotes-bg, #fffdf0); color:var(--quotes-text, #1b4332); box-sizing:border-box; }
-        .quotes-track { display:inline-block; white-space:nowrap; padding-right:100%; font-size:var(--quotes-size, 18px); font-weight:bold; animation:quotesMarquee var(--quotes-speed, 22s) linear infinite; }
-        @keyframes quotesMarquee { from { transform:translateX(0); } to { transform:translateX(-100%); } }
+        .quotes-track { display:inline-block; direction:ltr; white-space:nowrap; padding-right:0; font-size:var(--quotes-size, 18px); font-weight:bold; animation:quotesMarquee var(--quotes-speed, 22s) linear infinite; will-change:transform; }
+        @keyframes quotesMarquee { from { transform:translateX(0); } to { transform:translateX(-50%); } }
 
         .search-mic-btn {
             display:flex !important;
-- 
