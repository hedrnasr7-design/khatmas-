From 92104da7d4aeedf67869e7a676a0fc62d4986f52 Mon Sep 17 00:00:00 2001
From: Manus <manus@users.noreply.github.com>
Date: Tue, 8 Sep 2026 06:54:50 +0000
Subject: [PATCH] Retry Gemini vision requests and expose rename errors

---
 app.js | 55 +++++++++++++++++++++++++++++++++----------------------
 1 file changed, 33 insertions(+), 22 deletions(-)

diff --git a/app.js b/app.js
index 49851e9..dd8667b 100644
--- a/app.js
+++ b/app.js
@@ -45,26 +45,35 @@ const firebaseConfig = {
             let lastError = null;
 
             for (const model of [GEMINI_VISION_MODEL, GEMINI_VISION_FALLBACK_MODEL]) {
-                try {
-                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${encodeURIComponent(apiKey)}`, {
-                        method: 'POST',
-                        headers: { 'Content-Type': 'application/json' },
-                        body: JSON.stringify({
-                            contents: [{ parts: [
-                                { text: prompt },
-                                { inline_data: { mime_type: mimeType, data: base64Data } }
-                            ] }],
-                            generationConfig: { temperature: 0.1, maxOutputTokens: 120 }
-                        })
-                    });
-                    const result = await response.json();
-                    if (!response.ok) throw new Error(result.error?.message || `Gemini API ${response.status}`);
-                    const text = (result.candidates?.[0]?.content?.parts || [])
-                        .map(part => part.text || '').join(' ').trim();
-                    if (!text) throw new Error('لم تُرجع Gemini نصًا من الصورة');
-                    return text;
-                } catch (error) {
-                    lastError = error;
+                for (let attempt = 1; attempt <= 3; attempt++) {
+                    try {
+                        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${encodeURIComponent(apiKey)}`, {
+                            method: 'POST',
+                            headers: { 'Content-Type': 'application/json' },
+                            body: JSON.stringify({
+                                contents: [{ parts: [
+                                    { text: prompt },
+                                    { inline_data: { mime_type: mimeType, data: base64Data } }
+                                ] }],
+                                generationConfig: { temperature: 0.1, maxOutputTokens: 120 }
+                            })
+                        });
+                        const result = await response.json();
+                        if (!response.ok) {
+                            const apiError = new Error(result.error?.message || `Gemini API ${response.status}`);
+                            apiError.status = response.status;
+                            throw apiError;
+                        }
+                        const text = (result.candidates?.[0]?.content?.parts || [])
+                            .map(part => part.text || '').join(' ').trim();
+                        if (!text) throw new Error('لم تُرجع Gemini نصًا من الصورة');
+                        return text;
+                    } catch (error) {
+                        lastError = error;
+                        const retryable = [429, 500, 502, 503, 504].includes(error.status);
+                        if (!retryable || attempt === 3) break;
+                        await new Promise(resolve => setTimeout(resolve, attempt * 2500));
+                    }
                 }
             }
             throw lastError || new Error('تعذر الاتصال بخدمة Gemini');
@@ -998,6 +1007,7 @@ window.renameGenericImageTitles = async () => {
     let completed = 0;
     let renamed = 0;
     let failed = 0;
+    let lastRenameError = '';
 
     for (const [key, value] of targets) {
         try {
@@ -1017,16 +1027,17 @@ window.renameGenericImageTitles = async () => {
         } catch (error) {
             console.warn('تعذر إعادة تسمية الصورة:', key, error);
             failed++;
+            lastRenameError = error.message || 'خطأ غير معروف من Gemini';
         }
         completed++;
-        if (status) status.innerText = `تم تحليل ${completed} من ${targets.length} صورة، وأعيدت تسمية ${renamed}${failed ? `، وفشل تحليل ${failed}` : ''}.`;
+        if (status) status.innerText = `تم تحليل ${completed} من ${targets.length} صورة، وأعيدت تسمية ${renamed}${failed ? `، وفشل تحليل ${failed}` : ''}${lastRenameError ? ` — السبب الأخير: ${lastRenameError}` : ''}.`;
     }
 
     await OfflineStore.setMeta('firebase-etag', null);
     renderAdminLists(allKhatmas);
     filterKhatmas();
     if (button) button.disabled = false;
-    if (status) status.innerText = `اكتمل الفحص: أُعيدت تسمية ${renamed} من أصل ${targets.length}${failed ? `، وفشل تحليل ${failed}` : ''}.`;
+    if (status) status.innerText = `اكتمل الفحص: أُعيدت تسمية ${renamed} من أصل ${targets.length}${failed ? `، وفشل تحليل ${failed}` : ''}${lastRenameError ? ` — السبب الأخير: ${lastRenameError}` : ''}.`;
 };
 
 // نهاية وظيفة إعادة تسمية الختمات المصورة
-- 
