From 225615da2928ac5e2cf589591a2db4b35ff59c8a Mon Sep 17 00:00:00 2001
From: Manus <manus@users.noreply.github.com>
Date: Tue, 8 Sep 2026 15:25:11 +0000
Subject: [PATCH] Animate full quotes from left to right

---
 app.js     | 2 +-
 index.html | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/app.js b/app.js
index cddb517..6be3972 100644
--- a/app.js
+++ b/app.js
@@ -1304,7 +1304,7 @@ function applyQuotesSettings(settings, saveLocal = true) {
     const track = document.getElementById('quotesTrack');
     if (box && track) {
         const quoteLine = cleanTexts.join('   •   ');
-        track.textContent = quoteLine ? `${quoteLine}   •   ${quoteLine}` : '';
+        track.textContent = quoteLine;
         box.style.display = cleanTexts.length ? 'flex' : 'none';
         box.style.setProperty('--quotes-bg', merged.bg);
         box.style.setProperty('--quotes-text', merged.text);
diff --git a/index.html b/index.html
index 481fc82..cc3013a 100644
--- a/index.html
+++ b/index.html
@@ -107,8 +107,8 @@
         .search-box { flex: 1; padding: 7px 9px; height:44px; border-radius: 8px; border: 2px solid #1b4332; font-size: 15px; box-sizing: border-box; text-align: right; background: #fff; }
 
         .quotes-box { width:var(--content-width); height:42px; margin:0 auto 8px; border:2px solid var(--quotes-border, #1b4332); border-radius:9px; overflow:hidden; display:flex; align-items:center; background:var(--quotes-bg, #fffdf0); color:var(--quotes-text, #1b4332); box-sizing:border-box; }
-        .quotes-track { display:inline-block; direction:ltr; white-space:nowrap; padding-right:0; font-size:var(--quotes-size, 18px); font-weight:bold; animation:quotesMarquee var(--quotes-speed, 22s) linear infinite; will-change:transform; }
-        @keyframes quotesMarquee { from { transform:translateX(0); } to { transform:translateX(-50%); } }
+        .quotes-track { display:inline-block; direction:rtl; white-space:nowrap; padding:0; font-size:var(--quotes-size, 18px); font-weight:bold; animation:quotesMarquee var(--quotes-speed, 22s) linear infinite; will-change:transform; }
+        @keyframes quotesMarquee { from { transform:translateX(-100%); } to { transform:translateX(100%); } }
 
         .search-mic-btn {
             display:flex !important;
-- 
