diff --git a/app.js b/app.js
index 332d658..49851e9 100644
--- a/app.js
+++ b/app.js
@@ -8,6 +8,7 @@ const firebaseConfig = {
             appId: "1:361576127533:web:4e5b4947c2b6581596eca4"
         };
         const GEMINI_VISION_MODEL = 'gemini-2.5-flash';
+        const GEMINI_VISION_FALLBACK_MODEL = 'gemini-2.0-flash';
         const ADMIN_EMAIL = "hedrnasr7@gmail.com";
         firebase.initializeApp(firebaseConfig);
         const db = firebase.database();
@@ -37,6 +38,38 @@ const firebaseConfig = {
             return n.toString().replace(/\d/g, d => '٠١٢٣٤٥٦٧٨٩'[d]);
         }
 
+        async function askGeminiToReadImage(apiKey, imageSource, prompt) {
+            const dataUrlMatch = String(imageSource || '').match(/^data:([^;,]+);base64,(.+)$/s);
+            const mimeType = dataUrlMatch?.[1] || 'image/jpeg';
+            const base64Data = dataUrlMatch?.[2] || String(imageSource || '').replace(/^data:[^,]+,/, '');
+            let lastError = null;
+
+            for (const model of [GEMINI_VISION_MODEL, GEMINI_VISION_FALLBACK_MODEL]) {
+                try {
+                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${encodeURIComponent(apiKey)}`, {
+                        method: 'POST',
+                        headers: { 'Content-Type': 'application/json' },
+                        body: JSON.stringify({
+                            contents: [{ parts: [
+                                { text: prompt },
+                                { inline_data: { mime_type: mimeType, data: base64Data } }
+                            ] }],
+                            generationConfig: { temperature: 0.1, maxOutputTokens: 120 }
+                        })
+                    });
+                    const result = await response.json();
+                    if (!response.ok) throw new Error(result.error?.message || `Gemini API ${response.status}`);
+                    const text = (result.candidates?.[0]?.content?.parts || [])
+                        .map(part => part.text || '').join(' ').trim();
+                    if (!text) throw new Error('لم تُرجع Gemini نصًا من الصورة');
+                    return text;
+                } catch (error) {
+                    lastError = error;
+                }
+            }
+            throw lastError || new Error('تعذر الاتصال بخدمة Gemini');
+        }
+
         window.onload = () => {
             const savedKey = localStorage.getItem('gemini_api_key');
             if (savedKey) {
@@ -964,30 +997,14 @@ window.renameGenericImageTitles = async () => {
     if (button) button.disabled = true;
     let completed = 0;
     let renamed = 0;
+    let failed = 0;
 
     for (const [key, value] of targets) {
         try {
-            const base64Data = value.image.includes(',') ? value.image.split(',')[1] : value.image;
-            const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_VISION_MODEL}:generateContent?key=${apiKey}`, {
-                method: 'POST',
-                headers: { 'Content-Type': 'application/json' },
-                body: JSON.stringify({
-                    contents: [{ parts: [
-                        { text: 'اقرأ العنوان الرئيسي أو أول عنوان واضح داخل الصورة. أعد العنوان فقط دون شرح، ودون رقم تسلسلي، وبحد أقصى 60 حرفًا. إذا لم تجد عنوانًا واضحًا فاكتب: غير واضح' },
-                        { inline_data: { mime_type: 'image/jpeg', data: base64Data } }
-                    ] }]
-                })
-            });
-            const result = await response.json();
-            if (!response.ok) {
-                throw new Error(result.error?.message || `Gemini API ${response.status}`);
-            }
-            let extracted = '';
-            const candidateText = result.candidates?.[0]?.content?.parts?.[0]?.text;
-            if (candidateText) {
-                extracted = candidateText.trim().replace(/[*#]/g, '').split('\n')[0].trim();
-                extracted = extracted.replace(/^[\d٠-٩]+\s*[-_–—.:،)]*\s*/, '').substring(0, 60).trim();
-            }
+            let extracted = await askGeminiToReadImage(apiKey, value.image,
+                'اقرأ العنوان الرئيسي أو أول عنوان واضح داخل الصورة. أعد العنوان فقط دون شرح، ودون رقم تسلسلي، وبحد أقصى 60 حرفًا. إذا لم تجد عنوانًا واضحًا فاكتب: غير واضح');
+            extracted = extracted.replace(/[*#]/g, '').split('\n')[0].trim();
+            extracted = extracted.replace(/^[\d٠-٩]+\s*[-_–—.:،)]*\s*/, '').substring(0, 60).trim();
 
             if (extracted && extracted.length > 2 && !/غير\s*واضح|غير واضح|error/i.test(extracted)) {
                 const oldNumber = extractNumber(value.title || '');
@@ -999,17 +1016,17 @@ window.renameGenericImageTitles = async () => {
             }
         } catch (error) {
             console.warn('تعذر إعادة تسمية الصورة:', key, error);
-            if (status) status.innerText = `تعذر تحليل إحدى الصور: ${error.message || 'تحقق من مفتاح Gemini والاتصال بالإنترنت'}`;
+            failed++;
         }
         completed++;
-        if (status) status.innerText = `تم تحليل ${completed} من ${targets.length} صورة، وأعيدت تسمية ${renamed}.`;
+        if (status) status.innerText = `تم تحليل ${completed} من ${targets.length} صورة، وأعيدت تسمية ${renamed}${failed ? `، وفشل تحليل ${failed}` : ''}.`;
     }
 
     await OfflineStore.setMeta('firebase-etag', null);
     renderAdminLists(allKhatmas);
     filterKhatmas();
     if (button) button.disabled = false;
-    if (status) status.innerText = `اكتمل الفحص: أُعيدت تسمية ${renamed} من أصل ${targets.length}.`;
+    if (status) status.innerText = `اكتمل الفحص: أُعيدت تسمية ${renamed} من أصل ${targets.length}${failed ? `، وفشل تحليل ${failed}` : ''}.`;
 };
 
