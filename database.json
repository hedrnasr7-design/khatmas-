{
  "rules": {
    ".read": true,
    ".write": false,
    "khatmas": {
      ".read": true,
      ".write": "auth != null",
      "$khatmaId": {
        ".validate": "newData.val() === null || (newData.hasChildren(['title', 'content', 'image']) && newData.child('title').isString() && newData.child('content').isString() && newData.child('image').isString())"
      }
    },
    "appSettings": {
      ".read": true,
      "theme": {
        ".write": "auth != null && auth.token.email == 'hedrnasr7@gmail.com'",
        ".validate": "newData.hasChildren(['font', 'preset', 'tabColors'])"
      },
      "quotes": {
        ".write": "auth != null && auth.token.email == 'hedrnasr7@gmail.com'",
        ".validate": "newData.hasChildren(['texts', 'bg', 'text', 'border', 'size', 'speed']) && newData.child('bg').isString() && newData.child('text').isString() && newData.child('border').isString() && newData.child('size').isNumber() && newData.child('speed').isNumber()"
      }
    }
  }
}
